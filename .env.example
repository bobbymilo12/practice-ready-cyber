VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Set these as Supabase Edge Function secrets, never VITE_ variables:
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
# INVITE_FROM=PracticeReady <training@your-verified-domain.example>
# APP_URL=https://your-app.example
# ALLOWED_ORIGINS=https://your-app.example,http://localhost:5173
# Server-only TanStack contact form configuration:
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEYS={"default":"sb_secret_YOUR_PRIVATE_SECRET_KEY"}
# Or for a single key: SUPABASE_SECRET_KEY=sb_secret_YOUR_PRIVATE_SECRET_KEY
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
# CONTACT_FROM=PracticeReady <hello@your-verified-domain.example>
# CONTACT_TO=practicereadyuk@gmail.com
